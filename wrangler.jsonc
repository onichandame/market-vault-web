{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "market-vault-web",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "assets": {
    "directory": "./build/client",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "market-vault.onichandame.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "VITE_VAULT_BASE_URL": "https://quantor-vault.onichandame.com"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
